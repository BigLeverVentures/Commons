NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Required for scheduled storage cleanup; also used for optional directory matching and notification delivery.
SUPABASE_SERVICE_ROLE_KEY=
# Optional outbound notifications. Keep these server-only.
RESEND_API_KEY=
EMAIL_FROM=Commons <commons@your-domain.example>
APP_URL=https://commons.example.org
CRON_SECRET=

# Optional Cloudflare deployment; custom domains are empty by default.
CLOUDFLARE_WORKER_NAME=commons
CLOUDFLARE_DOMAINS=
# Enable application notifications only after sender/queue verification.
COMMONS_NOTIFICATIONS_ENABLED=false

# Optional explicit CPU cap in milliseconds. Requires Workers Paid; see deployment guide.
# Recommended for server-rendered deployments on Paid: 1000
COMMONS_WORKER_CPU_MS=
